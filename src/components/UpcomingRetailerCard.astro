---
import type { Retailer } from '../data/retailers';

interface Props {
  retailer: Retailer;
}

const { retailer } = Astro.props;
---

<!-- Same card as RetailerCard, with the "Coming soon" state sitting exactly where
     "Get directions" sits on a live shop. No directions link on purpose: these
     shops have not started stocking yet, so sending someone over would be wrong. -->
<article
  class="bg-canvas p-5"
  style={`border-radius: var(--rounded-sm); border: 1px solid var(--hairline-soft);`}
>
  <h3 class="text-[16px] font-medium leading-[1.5] text-ink">{retailer.name}</h3>
  <address class="not-italic text-[14px] font-normal leading-[1.5] text-ash mt-1">
    {retailer.address}<br />
    {retailer.city}, {retailer.state} {retailer.postalCode}
  </address>
  <span class="inline-flex items-center gap-2 mt-3 text-[14px] font-medium leading-[1.5] text-mute">
    <span class="w-1.5 h-1.5 rounded-full bg-stone" aria-hidden="true"></span>
    Coming soon
  </span>
</article>
