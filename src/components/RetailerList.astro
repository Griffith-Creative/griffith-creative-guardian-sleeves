---
import type { Retailer } from '../data/retailers';
import RetailerCard from './RetailerCard.astro';
import UpcomingRetailerCard from './UpcomingRetailerCard.astro';

interface Props {
  retailers: Retailer[];
  upcoming?: Retailer[];
}

const { retailers, upcoming = [] } = Astro.props;
---

<section class="py-[var(--space-section)] bg-soft-cloud">
  <div class="container-guardian">
    <h2 class="font-display text-[32px] md:text-[48px] leading-[0.9] uppercase text-ink mb-8">
      All locations
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {retailers.map((retailer) => (
        <RetailerCard retailer={retailer} />
      ))}
    </div>

    {upcoming.length > 0 && (
      <div class="mt-[var(--space-section)]">
        <h3 class="font-display text-[26px] md:text-[36px] leading-[0.9] uppercase text-ink">
          Coming soon
        </h3>
        <p class="text-[15px] leading-[1.5] text-mute mt-2 mb-6">
          Shops adding Guardian to their shelves next.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {upcoming.map((retailer) => (
            <UpcomingRetailerCard retailer={retailer} />
          ))}
        </div>
      </div>
    )}
  </div>
</section>
